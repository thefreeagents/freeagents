# Copy this file to ".env" and fill in your own values.

# The port the site runs on (most hosts set this automatically)
PORT=3000

# A long random string that keeps admin logins secure. Change it!
SESSION_SECRET=please-change-this-to-a-long-random-string

# The first admin login created when you seed the database.
# You can change the password later inside the admin console.
ADMIN_USER=commissioner
ADMIN_PASS=changeme123
