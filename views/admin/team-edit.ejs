<%- include('partials/head', { nav: 'teams' }) %>

<a href="/admin" style="text-decoration:none;color:#5b6472;font-weight:600">← All teams</a>
<h1 class="admin-h1" style="margin-top:6px"><%= team.name %></h1>
<p class="admin-sub">Edit team details and roster, then click <strong>Save</strong> at the bottom. Changes go live immediately.</p>

<% if (flash) { %><div class="flash">Saved! <a href="/team/<%= team.slug %>" target="_blank">View on site ↗</a></div><% } %>

<form method="post" action="/admin/teams/<%= team.id %>" enctype="multipart/form-data">
  <div class="card">
    <h2>Team details</h2>
    <div class="grid2">
      <div class="field">
        <label>Team name</label>
        <input type="text" name="name" value="<%= team.name %>" required />
      </div>
      <div class="field">
        <label>Owner</label>
        <input type="text" name="owner" value="<%= team.owner %>" />
      </div>
    </div>
    <div class="field">
      <label>Tagline / motto</label>
      <input type="text" name="tagline" value="<%= team.tagline %>" placeholder="Optional" />
    </div>
    <div class="field">
      <label>Championship years</label>
      <input type="text" name="championships" value="<%= team.championships %>" placeholder="e.g. 2013, 2018, 2021" />
      <p class="hint">Comma-separated years. Each becomes a trophy on the team page.</p>
    </div>
    <div class="grid2">
      <div class="field">
        <label>All-time record</label>
        <input type="text" name="all_time_record" value="<%= team.all_time_record || '' %>" placeholder="e.g. 84-62-1" />
      </div>
      <div class="field">
        <label>All-time points scored</label>
        <input type="text" name="all_time_pf" value="<%= team.all_time_pf || '' %>" placeholder="e.g. 14203.5" />
      </div>
    </div>
    <div class="field">
      <label>Seasons played</label>
      <input type="number" name="all_time_seasons" value="<%= team.all_time_seasons || '' %>" placeholder="e.g. 12" style="max-width:140px" />
      <p class="hint">These fill in automatically from ESPN history when you run a Sync, but you can adjust them by hand here.</p>
    </div>
    <div class="field">
      <label>Team banner image (optional)</label>
      <input type="file" name="image" accept="image/*" />
      <% if (team.image) { %><p class="hint">Current: <%= team.image %> — upload a new file to replace it.</p><% } %>
    </div>

    <div class="grid2">
      <div class="field">
        <label>Owner login email</label>
        <input type="email" name="email" value="<%= team.email || '' %>" placeholder="owner@example.com" autocomplete="off" />
        <p class="hint">The owner signs in with this email to make their own off-season moves.</p>
      </div>
      <div class="field">
        <label>Set / reset owner password</label>
        <input type="text" id="owner_password" name="new_password" placeholder="<%= team.password_hash ? 'Leave blank to keep current' : 'Set a password' %>" autocomplete="new-password" />
        <label class="checkline" style="margin-top:6px;font-weight:normal">
          <input type="checkbox" onchange="document.getElementById('owner_password').type = this.checked ? 'password' : 'text'" />
          Hide password
        </label>
        <p class="hint"><%= team.password_hash ? 'A password is set. Type a new one to change it.' : 'No password set yet — the owner cannot log in until you set one.' %> Leave the email blank to disable this team's login.</p>
      </div>
    </div>
  </div>

  <div class="card">
    <h2>Roster</h2>
    <p class="hint" style="margin:-6px 0 12px">For contracts, put each year on its own line, e.g. <code>2025: $12</code> then <code>2026: $12</code>. Leave blank if none. Empty player rows are ignored when you save. Use the <strong>▲ ▼</strong> arrows to reorder players within a section, then click <strong>Save changes</strong>.</p>

    <% sections.forEach(function(s){ %>
      <div class="section-block">
        <h3><%= s.label %></h3>
        <div class="player-rows" data-section="<%= s.key %>">
          <% (roster.find(function(r){return r.key===s.key;}).players).forEach(function(p){ %>
            <% var key = 'p' + p.id; %>
            <div class="player-row">
              <div class="p-photo">
                <div class="thumb">
                  <% if (p.image) { %><img src="/uploads/<%= p.image %>" alt="" /><% } else { %><span class="noimg">No photo</span><% } %>
                </div>
                <label class="filepick">Photo
                  <input type="file" name="p_image_<%= key %>" accept="image/*" />
                </label>
                <% if (p.image) { %>
                  <label class="rm"><input type="checkbox" name="p_removeimg_<%= key %>" value="1" /> remove</label>
                <% } %>
              </div>
              <div class="p-main">
                <input type="text" name="p_name" value="<%= p.name %>" placeholder="Player name" />
                <input type="hidden" name="p_section" value="<%= s.key %>" />
                <input type="hidden" name="p_id" value="<%= p.id %>" />
                <input type="hidden" name="p_imgkey" value="<%= key %>" />
                <textarea name="p_contracts" placeholder="2025: $12&#10;2026: $12"><%= p.contracts %></textarea>
              </div>
              <div class="p-move">
                <button type="button" class="mv" title="Move up" onclick="moveRow(this,-1)">▲</button>
                <button type="button" class="mv" title="Move down" onclick="moveRow(this,1)">▼</button>
              </div>
              <button type="button" class="del" onclick="this.closest('.player-row').remove()">✕</button>
            </div>
          <% }); %>
        </div>
        <div class="addrow" style="padding:0 14px 14px">
          <button type="button" class="btn small green" onclick="addRow('<%= s.key %>')">+ Add player</button>
        </div>
      </div>
    <% }); %>
  </div>

  <div class="btnrow">
    <button class="btn" type="submit">Save changes</button>
    <a class="btn secondary" href="/team/<%= team.slug %>" target="_blank">Preview page</a>
  </div>
</form>

<% if (offseasonOn) {
     var contractPlayers = (roster.find(function(r){return r.key==='contract';}) || {players:[]}).players;
     var taxiPlayers = (roster.find(function(r){return r.key==='taxi';}) || {players:[]}).players;
     var ncaaPlayers = (roster.find(function(r){return r.key==='ncaa_player';}) || {players:[]}).players;
     var ncaacPlayers = (roster.find(function(r){return r.key==='ncaa_contract';}) || {players:[]}).players;
     var taxiSpots = caps.taxi - counts.taxi;
     var mbase = '/admin/teams/' + team.id;
     // Pull the player's current-season price from their contract lines
     // (e.g. "2026: $12") to show the cost of a promote/retain/activate.
     var curYear = String(typeof startYear !== 'undefined' ? startYear : new Date().getFullYear());
     function priceFor(contracts){
       if (!contracts) return '';
       var found = '';
       contracts.split(/\r?\n/).forEach(function(line){
         var mm = line.match(/(\d{4})\s*:\s*\$?\s*(\d+)/);
         if (mm && mm[1] === curYear) found = '$' + mm[2];
       });
       return found;
     }
     function costLabel(base, contracts){
       var pr = priceFor(contracts);
       return pr ? (base + ' (' + pr + ')') : base;
     }
     // Current-season salary as a number (0 if none), for the live cap meter.
     function priceNum(contracts){ var s = priceFor(contracts); return s ? parseInt(s.replace(/[^0-9]/g,''),10) : 0; }
     // The $200 cap counts Contract Players + NCAA Contracts (per league rules).
     var CAP = 200;
     var capBase = 0;
     contractPlayers.forEach(function(p){ capBase += priceNum(p.contracts); });
     ncaacPlayers.forEach(function(p){ capBase += priceNum(p.contracts); });
%>
<div class="card offseason-panel" style="margin-top:26px">
  <h2>Off-Season Moves</h2>
  <p class="hint" style="margin-top:-6px">Choose what to do with each player, then press <strong>Submit</strong> at the
    bottom to apply every move at once. Nothing changes until you submit, and if any move would break a cap the
    whole submission is cancelled. Caps: max <%= caps.contract %> Contract Players, max <%= caps.taxi %> Taxi Squad players.
    <strong>All changes can be undone until the pre-season locks.</strong></p>

  <% if (typeof osmsg !== 'undefined' && osmsg) { %>
    <div class="flash <%= oswarn ? 'warn' : '' %>"><%= osmsg %></div>
  <% } %>

  <div class="os-capmeter" id="os-capmeter" data-base="<%= capBase %>" data-cap="<%= CAP %>">
    <div class="os-capmeter-head">
      <span class="os-cap-label">Salary used</span>
      <span class="os-cap-figure"><strong id="os-cap-used">$<%= capBase %></strong> <span class="os-cap-of">/ $<%= CAP %></span></span>
    </div>
    <div class="os-capbar"><div class="os-capbar-fill" id="os-cap-fill"></div></div>
    <p class="os-cap-note" id="os-cap-note"></p>
  </div>

  <!-- Empty shell form: batch inputs below are linked to it with form="osform-admin"
       so the standalone "set terms" / "mark eligible" forms can sit inline without nesting. -->
  <form method="post" action="<%= mbase %>/moves/submit" id="osform-admin" class="osform"></form>

  <!-- Contract Players: retain / drop (penalty = current-season price) -->
  <div class="os-group">
    <h3>Contract Players <span class="cnt"><%= counts.contract %>/<%= caps.contract %></span></h3>
    <% if (!contractPlayers.length) { %>
      <p class="os-empty">No Contract Players.</p>
    <% } else { %>
      <% contractPlayers.forEach(function(p){ var pr = priceFor(p.contracts); %>
        <div class="os-row">
          <span class="os-name"><%= p.name %></span>
          <div class="os-choices" role="radiogroup" aria-label="<%= p.name %>">
            <label class="os-opt"><input form="osform-admin" type="radio" name="contract_<%= p.id %>" value="keep" checked
                     data-player="<%= p.name %>" data-move=""> <%= costLabel('Retain', p.contracts) %></label>
            <label class="os-opt danger"><input form="osform-admin" type="radio" name="contract_<%= p.id %>" value="drop"
                     data-player="<%= p.name %>" data-move="drop from Contract Players<%= pr ? ' (penalty ' + pr + ')' : '' %>"> Drop<%= pr ? ' (Penalty ' + pr + ')' : '' %></label>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>

  <!-- NCAA Contracts: retain / drop -->
  <div class="os-group">
    <h3>NCAA Contracts</h3>
    <% if (!ncaacPlayers.length) { %>
      <p class="os-empty">No NCAA Contract players.</p>
    <% } else { %>
      <% ncaacPlayers.forEach(function(p){ %>
        <div class="os-row">
          <span class="os-name"><%= p.name %></span>
          <div class="os-choices" role="radiogroup" aria-label="<%= p.name %>">
            <label class="os-opt"><input form="osform-admin" type="radio" name="ncaac_<%= p.id %>" value="keep" checked
                     data-player="<%= p.name %>" data-move=""> <%= costLabel('Retain', p.contracts) %></label>
            <label class="os-opt danger"><input form="osform-admin" type="radio" name="ncaac_<%= p.id %>" value="drop"
                     data-player="<%= p.name %>" data-move="drop from NCAA Contracts"
                     data-cap-delta="<%= -priceNum(p.contracts) %>"> Drop</label>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>

  <!-- Taxi Squad: keep / promote / drop -->
  <div class="os-group">
    <h3>Taxi Squad <span class="cnt"><%= counts.taxi %>/<%= caps.taxi %></span></h3>
    <% if (!taxiPlayers.length) { %>
      <p class="os-empty">No Taxi Squad players.</p>
    <% } else { %>
      <% taxiPlayers.forEach(function(p){ %>
        <div class="os-row">
          <span class="os-name"><%= p.name %></span>
          <div class="os-choices" role="radiogroup" aria-label="<%= p.name %>">
            <label class="os-opt"><input form="osform-admin" type="radio" name="taxi_<%= p.id %>" value="keep" checked
                     data-player="<%= p.name %>" data-move=""> Taxi</label>
            <label class="os-opt"><input form="osform-admin" type="radio" name="taxi_<%= p.id %>" value="promote"
                     data-player="<%= p.name %>" data-move="<%= costLabel('promote to NCAA Contracts', p.contracts) %>"
                     data-cap-delta="<%= priceNum(p.contracts) %>"> <%= costLabel('Promote to NCAA Contracts', p.contracts) %></label>
            <label class="os-opt danger"><input form="osform-admin" type="radio" name="taxi_<%= p.id %>" value="drop"
                     data-player="<%= p.name %>" data-move="drop from Taxi Squad"> Drop</label>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>

  <!-- NCAA Players: keep / activate / taxi / drop (choosing one implies eligible) -->
  <div class="os-group">
    <h3>NCAA Players</h3>
    <p class="hint">Pick <strong>Activate</strong> (to NCAA Contracts), <strong>Taxi</strong> (Taxi Squad),
      or <strong>Drop</strong> for any player — choosing a move makes them eligible automatically on submit.
      Use <strong>Mark eligible</strong> only to let a team make the choice themselves on their own page.
      Taxi Squad has <%= taxiSpots %> open spot<%= taxiSpots === 1 ? '' : 's' %>.</p>
    <% if (!ncaaPlayers.length) { %>
      <p class="os-empty">No NCAA Players.</p>
    <% } else { %>
      <% ncaaPlayers.forEach(function(p){ %>
        <div class="os-row">
          <span class="os-name"><%= p.name %>
            <% if (p.eligible) { %><span class="tag ok">eligible</span><% } %></span>
          <div class="os-choices" role="radiogroup" aria-label="<%= p.name %>">
            <input form="osform-admin" type="radio" name="ncaa_<%= p.id %>" value="keep" <%= p.eligible ? '' : 'checked' %> hidden
                   data-player="<%= p.name %>" data-move="" data-elig="<%= p.eligible ? '1' : '0' %>">
            <label class="os-opt"><input form="osform-admin" type="radio" name="ncaa_<%= p.id %>" value="activate"
                     data-player="<%= p.name %>" data-move="<%= costLabel('activate to NCAA Contracts', p.contracts) %>"
                     data-cap-delta="<%= priceNum(p.contracts) %>"> <%= costLabel('Activate', p.contracts) %></label>
            <label class="os-opt"><input form="osform-admin" type="radio" name="ncaa_<%= p.id %>" value="taxi" <%= p.eligible ? 'checked' : '' %>
                     data-player="<%= p.name %>" data-move="promote to Taxi Squad"> Taxi</label>
            <label class="os-opt danger"><input form="osform-admin" type="radio" name="ncaa_<%= p.id %>" value="drop"
                     data-player="<%= p.name %>" data-move="drop from NCAA Players"> Drop</label>
          </div>
          <form method="post" action="<%= mbase %>/moves/eligible/<%= p.id %>" class="os-elig">
            <button class="btn small gray" type="submit"><%= p.eligible ? 'Unmark eligible' : 'Mark eligible' %></button>
          </form>
        </div>
      <% }); %>
    <% } %>
  </div>

  <!-- Sign from ESPN -> Contract Players -->
  <div class="os-group">
    <h3>Sign from ESPN → Contract Players <span class="cnt"><%= counts.contract %>/<%= caps.contract %></span></h3>
    <p class="hint">Set the available terms for a player (immediate), then check them to sign on submit.
      <strong>Auction:</strong> 1–3 years at the auction price. <strong>Waiver:</strong> 1–2 years at $11 / $15.</p>
    <% if (!espnPlayers.length) { %>
      <p class="os-empty">No players on the ESPN list. Run an ESPN Sync first, or all ESPN players are already categorized.</p>
    <% } else { %>
      <% espnPlayers.forEach(function(p){
           var offer = offers[p.name];
           var acq = offer ? offer.acq_type : 'auction';
           var yrs = maxYears(acq);
           // First-year salary added to the cap if signed: waiver = $11, auction = the price.
           var firstYear = offer ? (offer.acq_type === 'waiver' ? 11 : (parseInt(offer.auction_price, 10) || 0)) : 0;
      %>
        <div class="os-espn">
          <div class="os-espn-head">
            <label class="os-sign-check">
              <input form="osform-admin" type="checkbox" name="sign_<%= p.id %>" value="1" <%= offer ? '' : 'disabled' %>
                     data-player="<%= p.name %>" data-move="sign to Contract Players"
                     data-cap-delta="<%= firstYear %>">
              <span class="os-name"><%= p.name %></span>
            </label>
            <% if (offer) { %><span class="tag ok"><%= offSummary(offer.acq_type, offer.auction_price) %></span><% } else { %><span class="tag">no terms set</span><% } %>
            <% if (offer) { %>
              <label class="os-years">Years
                <select form="osform-admin" name="years_<%= p.id %>">
                  <% for (var y=1; y<=yrs; y++){ %><option value="<%= y %>"><%= y %></option><% } %>
                </select>
              </label>
            <% } %>
          </div>

          <!-- Set / update available contract terms (immediate, standalone form) -->
          <form method="post" action="<%= mbase %>/moves/offer" class="os-offer" oninput="osToggle(this)">
            <input type="hidden" name="player_name" value="<%= p.name %>" />
            <label>Acquired via
              <select name="acq_type">
                <option value="auction" <%= acq==='auction'?'selected':'' %>>Auction</option>
                <option value="waiver" <%= acq==='waiver'?'selected':'' %>>Waiver</option>
              </select>
            </label>
            <label class="os-price" style="<%= acq==='waiver'?'display:none':'' %>">Auction $
              <input type="number" name="auction_price" min="1" value="<%= offer ? offer.auction_price : '' %>" style="width:80px" />
            </label>
            <button class="btn small" type="submit">Save terms</button>
          </form>
        </div>
      <% }); %>
    <% } %>
  </div>

  <!-- Live "what will happen" summary -->
  <div class="os-pending" id="os-pending" hidden>
    <h3>Pending moves <span class="cnt" id="os-pending-count">0</span></h3>
    <ul id="os-pending-list"></ul>
  </div>
  <p class="os-pending-empty" id="os-pending-empty">No moves selected yet.</p>
  <p class="os-need" id="os-need-admin" hidden></p>

  <div class="os-submitbar">
    <button class="btn green" form="osform-admin" type="submit" id="os-submit" disabled>Submit moves</button>
    <button class="btn gray" type="button" id="os-reset">Clear selections</button>
  </div>
</div>

<script>
  // Show the auction price field only when "Auction" is selected.
  function osToggle(form){
    var acq = form.querySelector('select[name=acq_type]').value;
    var price = form.querySelector('.os-price');
    if (price) price.style.display = (acq === 'waiver') ? 'none' : '';
  }

  // Batch "Pending moves" summary. Inputs are linked via form="osform-admin", so
  // read them from form.elements (they live outside the form element in the DOM).
  (function(){
    var form = document.getElementById('osform-admin');
    if (!form) return;
    var listEl  = document.getElementById('os-pending-list');
    var wrapEl  = document.getElementById('os-pending');
    var emptyEl = document.getElementById('os-pending-empty');
    var countEl = document.getElementById('os-pending-count');
    var submit  = document.getElementById('os-submit');
    var needEl  = document.getElementById('os-need-admin');

    // Live salary meter. Inputs are linked via form="osform-admin", so their
    // deltas are read from form.elements (they sit outside the form in the DOM).
    function updateCap(){
      var meter = document.getElementById('os-capmeter');
      if (!meter) return;
      var base = parseInt(meter.dataset.base, 10) || 0;
      var cap  = parseInt(meter.dataset.cap, 10) || 200;
      var total = base;
      Array.prototype.forEach.call(form.elements, function(el){
        if (el.checked && el.dataset && el.dataset.capDelta) total += parseInt(el.dataset.capDelta, 10) || 0;
      });
      document.getElementById('os-cap-used').textContent = '$' + total;
      document.getElementById('os-cap-fill').style.width = Math.max(0, Math.min(100, Math.round(total / cap * 100))) + '%';
      meter.classList.toggle('over', total > cap);
      var note = document.getElementById('os-cap-note');
      if (note){
        note.textContent = total > cap
          ? '$' + (total - cap) + ' over the $' + cap + ' cap (allowed only to sign NCAA/Collegiate players).'
          : '$' + (cap - total) + ' of cap space remaining.';
      }
    }

    // Eligible NCAA players must be given a real choice (Activate / Taxi / Drop)
    // before submit — an eligible player left on "keep" blocks the whole batch.
    function undecidedEligible(){
      var keeps = [];
      Array.prototype.forEach.call(form.elements, function(el){
        if (el.type === 'radio' && el.value === 'keep' && el.dataset && el.dataset.elig === '1') keeps.push(el);
      });
      var names = [];
      keeps.forEach(function(keep){
        var checked = null;
        Array.prototype.forEach.call(form.elements, function(el){
          if (el.type === 'radio' && el.name === keep.name && el.checked) checked = el;
        });
        if (!checked || checked.value === 'keep') names.push(keep.dataset.player || keep.name);
      });
      return names;
    }

    function selected(){
      var out = [];
      Array.prototype.forEach.call(form.elements, function(el){
        if (!el.dataset || !el.dataset.move) return;
        if (el.type === 'radio' && el.checked && el.value !== 'keep') {
          out.push({ el: el, player: el.dataset.player, move: el.dataset.move });
        } else if (el.type === 'checkbox' && el.checked) {
          out.push({ el: el, player: el.dataset.player, move: el.dataset.move });
        }
      });
      return out;
    }
    function clearOne(item){
      if (item.el.type === 'checkbox') { item.el.checked = false; }
      else {
        Array.prototype.forEach.call(form.elements, function(el){
          if (el.type === 'radio' && el.name === item.el.name && el.value === 'keep') el.checked = true;
        });
      }
      render();
    }
    function render(){
      var items = selected();
      listEl.innerHTML = '';
      items.forEach(function(it){
        var li = document.createElement('li');
        var txt = document.createElement('span');
        txt.textContent = it.player + ' — ' + it.move;
        var rm = document.createElement('button');
        rm.type = 'button'; rm.className = 'os-remove'; rm.textContent = 'remove';
        rm.addEventListener('click', function(){ clearOne(it); });
        li.appendChild(txt); li.appendChild(rm); listEl.appendChild(li);
      });
      countEl.textContent = items.length;
      wrapEl.hidden = items.length === 0;
      emptyEl.hidden = items.length !== 0;
      var undecided = undecidedEligible();
      if (needEl) {
        if (undecided.length) {
          needEl.textContent = 'Choose Activate, Taxi, or Drop for every eligible NCAA player before submitting: ' + undecided.join(', ') + '.';
          needEl.hidden = false;
        } else {
          needEl.hidden = true;
        }
      }
      submit.disabled = (items.length === 0) || (undecided.length > 0);
      updateCap();
    }
    form.addEventListener('change', render);
    document.addEventListener('change', function(e){
      if (e.target && e.target.form === form) render();
    });
    document.getElementById('os-reset').addEventListener('click', function(){ form.reset(); render(); });
    form.addEventListener('submit', function(e){
      var items = selected();
      if (!items.length || undecidedEligible().length) { e.preventDefault(); return; }
      if (!confirm('Submit ' + items.length + ' move' + (items.length===1?'':'s') + ' now?')) e.preventDefault();
    });
    render();
  })();
</script>
<% } %>

<% if (typeof txnGroups !== 'undefined' && txnGroups.length) { %>
<div class="card txn-card" style="margin-top:26px">
  <h2>Offseason Submissions</h2>
  <p class="hint" style="margin-top:-6px">Each submission is a group of moves.<%= offseasonOn ? ' Use Undo to reverse a whole submission.' : ' Turn on Off-Season Mode to undo.' %></p>
  <ul class="txn-list">
    <% txnGroups.forEach(function(g){ %>
      <li class="txn txn-group <%= g.allUndone ? 'is-undone' : '' %>">
        <div class="txn-main">
          <ul class="txn-items">
            <% g.items.forEach(function(tx){ %>
              <li class="<%= tx.undone ? 'is-undone' : '' %>"><%= tx.summary %></li>
            <% }); %>
          </ul>
          <span class="txn-date"><%= g.created_at %></span>
        </div>
        <div class="txn-side">
          <% if (g.allUndone) { %>
            <span class="tag">undone</span>
          <% } else if (offseasonOn) { %>
            <% var undoAction = g.batchId != null ? mbase + '/moves/undo-batch/' + g.batchId : mbase + '/moves/undo/' + g.txnId; %>
            <form method="post" action="<%= undoAction %>"
                  onsubmit="return confirm('Undo this whole submission and reset the team to how it was before?');">
              <button class="btn small gray" type="submit">Undo submission</button>
            </form>
          <% } %>
        </div>
      </li>
    <% }); %>
  </ul>
</div>
<% } %>

<div class="card" style="margin-top:26px;border-color:#f3c1bc">
  <h2 style="color:#b3261e">Danger zone</h2>
  <form method="post" action="/admin/teams/<%= team.id %>/delete" onsubmit="return confirm('Delete this team and its whole roster? This cannot be undone.');">
    <button class="btn danger small" type="submit">Delete team</button>
  </form>
</div>

<script>
  var rowSeq = 0;
  function addRow(section){
    var key = 'new' + (Date.now()) + '_' + (rowSeq++);
    var row = document.createElement('div');
    row.className = 'player-row';
    row.innerHTML =
      '<div class="p-photo">' +
        '<div class="thumb"><span class="noimg">No photo</span></div>' +
        '<label class="filepick">Photo<input type="file" accept="image/*"></label>' +
      '</div>' +
      '<div class="p-main">' +
        '<input type="text" name="p_name" placeholder="Player name">' +
        '<input type="hidden" name="p_section">' +
        '<input type="hidden" name="p_id" value="">' +
        '<input type="hidden" name="p_imgkey">' +
        '<textarea name="p_contracts" placeholder="2025: $12&#10;2026: $12"></textarea>' +
      '</div>' +
      '<div class="p-move">' +
        '<button type="button" class="mv" title="Move up" onclick="moveRow(this,-1)">\u25B2</button>' +
        '<button type="button" class="mv" title="Move down" onclick="moveRow(this,1)">\u25BC</button>' +
      '</div>' +
      '<button type="button" class="del" onclick="this.closest(\'.player-row\').remove()">\u2715</button>';
    row.querySelector('input[name=p_section]').value = section;
    row.querySelector('input[name=p_imgkey]').value = key;
    row.querySelector('.filepick input[type=file]').name = 'p_image_' + key;
    var container = document.querySelector('.player-rows[data-section="'+section+'"]');
    container.appendChild(row);
    row.querySelector('input[name=p_name]').focus();
  }

  // Move a player row up or down within its own section. The save handler writes
  // each player's display order from top-to-bottom row order, so reordering here
  // and clicking "Save changes" persists the new order for that category.
  function moveRow(btn, dir){
    var row = btn.closest('.player-row');
    if (!row) return;
    if (dir < 0){
      var prev = row.previousElementSibling;
      if (prev && prev.classList.contains('player-row')) row.parentNode.insertBefore(row, prev);
    } else {
      var next = row.nextElementSibling;
      if (next && next.classList.contains('player-row')) row.parentNode.insertBefore(next, row);
    }
  }
</script>

