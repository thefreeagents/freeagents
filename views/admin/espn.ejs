<%- include('partials/head', { nav: 'espn' }) %>

<h1 class="admin-h1">ESPN Sync</h1>
<p class="admin-sub">Pull live rosters and standings from your ESPN league. This only fills the
  <strong>“On ESPN Roster”</strong> section — your Contract, NCAA Contract, Taxi Squad and NCAA Player
  lists are never touched.</p>

<% if (flash) { %>
  <div class="flash">
    <% if (flash==='settings') { %>League settings saved.
    <% } else if (flash==='mapped') { %>Team mapping saved.
    <% } else { %>Saved!<% } %>
  </div>
<% } %>
<% if (error) { %><div class="flash warn"><%= error %></div><% } %>

<!-- 1. League settings -------------------------------------------------->
<div class="card">
  <h2>1. League</h2>
  <form method="post" action="/admin/espn/settings">
    <div class="field">
      <label>ESPN League ID</label>
      <input type="text" name="league_id" value="<%= settings.league_id || '' %>" placeholder="e.g. 374586" />
      <p class="hint">Found in your ESPN league URL. The league must be set to <strong>Public</strong>.</p>
    </div>
    <div class="field">
      <label>Season</label>
      <input type="text" name="season" value="<%= settings.season || '' %>" placeholder="<%= new Date().getFullYear() %>" style="max-width:140px" />
      <p class="hint">The season whose rosters and standings you want to display.</p>
    </div>
    <div class="field">
      <label>Auction price season</label>
      <input type="text" name="auction_season" value="<%= settings.auction_season || '' %>" placeholder="<%= (parseInt(settings.season,10) || new Date().getFullYear()) - 1 %>" style="max-width:140px" />
      <p class="hint">The season whose <strong>auction results</strong> supply contract prices (step 4).
        You hold an auction each year, and last year's winning bids become this year's contract
        prices — so this is usually the season <em>before</em> the roster season. Leave blank to
        default to one season before the roster season. Player IDs are stable across seasons, so
        prices map onto your current roster automatically.</p>
    </div>
    <button class="btn" type="submit">Save league settings</button>
  </form>
</div>

<!-- 2. Map ESPN teams to site teams ------------------------------------->
<div class="card">
  <h2>2. Match teams</h2>
  <p class="hint">ESPN team names don’t always match your site team names, so match them up once.
    Click “Load ESPN teams” to fetch the current league and pick the matching site team for each.</p>
  <form method="post" action="/admin/espn/map">
    <button class="btn green" type="submit">Load ESPN teams</button>
  </form>

  <% if (mapping) { %>
    <form method="post" action="/admin/espn/map/save" style="margin-top:16px">
      <p><strong>League:</strong> <%= mapping.leagueName || '—' %> &nbsp;·&nbsp; <strong>Season:</strong> <%= mapping.season %></p>
      <table class="teams">
        <thead><tr><th>ESPN team</th><th>Record</th><th>Matches site team</th></tr></thead>
        <tbody>
          <% mapping.rows.forEach(function(r){ %>
            <tr>
              <td><strong><%= r.espnName %></strong></td>
              <td><%= r.record %></td>
              <td>
                <select name="map[t<%= r.espnId %>]">
                  <option value="">— not in league / skip —</option>
                  <% mapping.siteTeams.forEach(function(st){ %>
                    <option value="<%= st.id %>" <%= String(r.suggestedSiteId)===String(st.id) ? 'selected' : '' %>><%= st.name %></option>
                  <% }); %>
                </select>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <button class="btn" type="submit" style="margin-top:12px">Save matches</button>
    </form>
  <% } %>
</div>

<!-- 3. Run the sync ----------------------------------------------------->
<div class="card">
  <h2>3. Sync now</h2>
  <p class="hint">Updates each matched team’s record, points, and “On ESPN Roster” list.
    <% if (settings.last_sync) { %>Last synced: <strong><%= new Date(settings.last_sync).toLocaleString() %></strong>.<% } else { %>Never synced yet.<% } %>
  </p>
  <form method="post" action="/admin/espn/sync">
    <button class="btn green big" type="submit">Sync from ESPN</button>
  </form>

  <% if (report) { %>
    <div style="margin-top:18px">
      <p><strong>Synced <%= report.leagueName || 'league' %></strong> (<%= report.season %>) on <%= report.when %>.</p>

      <% if (report.unmapped && report.unmapped.length) { %>
        <div class="flash warn">
          Not matched to an ESPN team (skipped): <%= report.unmapped.join(', ') %>.
          Use “Match teams” above to link them.
        </div>
      <% } %>

      <% if (report.duplicateMapping && report.duplicateMapping.length) { %>
        <div class="flash warn">
          These site teams share the same ESPN team, so they pulled the same roster:
          <%= report.duplicateMapping.join(', ') %>. Re-open “Match teams” and give each a
          different ESPN team.
        </div>
      <% } %>

      <table class="teams">
        <thead><tr><th>Site team</th><th>ESPN team</th><th>Record</th><th>On ESPN roster</th><th>Newly added</th><th>Possibly dropped</th></tr></thead>
        <tbody>
          <% report.teams.forEach(function(t){ %>
            <tr>
              <td><strong><%= t.team %></strong></td>
              <% if (t.error) { %>
                <td colspan="5" class="warn-cell"><%= t.error %></td>
              <% } else { %>
                <td><%= t.espnTeam %></td>
                <td><%= t.record %></td>
                <td><%= t.espnActiveCount %></td>
                <td><%= (t.added && t.added.length) ? t.added.join(', ') : '—' %></td>
                <td>
                  <% if (t.possiblyDropped && t.possiblyDropped.length) { %>
                    <%= t.possiblyDropped.map(function(p){ return p.name; }).join(', ') %>
                  <% } else { %>—<% } %>
                </td>
              <% } %>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <p class="hint">“Possibly dropped” players are only listed here for your review — the sync never removes
        anyone from your contract lists automatically.</p>
    </div>
  <% } %>
</div>

<!-- 4. Set contract prices from ESPN ------------------------------------->
<div class="card">
  <h2>4. Set contract prices from ESPN</h2>
  <p class="hint">Reads each “On ESPN Roster” player's <strong>acquisition type</strong> straight from
    ESPN, and pulls each player's <strong>winning auction bid</strong> from the
    <strong>Auction price season</strong> set in step 1 (matched by ESPN player ID, which is stable
    across seasons). It then sets their contract terms: drafted at auction and still held &rarr; that
    auction price (1–3 yrs); everyone else — picked up on waivers, free agency, or a trade &rarr;
    waiver terms $11 / $15 (1–2 yrs). Players already filed under Contract Players or NCAA Contracts
    are left alone.</p>
  <p class="hint">Run the roster sync first so every player is imported, then set prices. Every offer
    is editable afterward before it's signed.</p>
  <form method="post" action="/admin/espn/pricing">
    <button class="btn green" type="submit">Set contract prices from ESPN</button>
  </form>

  <% if (typeof pricing !== 'undefined' && pricing) { %>
    <div style="margin-top:18px">
      <div class="flash">
        Priced <strong><%= pricing.priced %></strong> ESPN-roster players
        (<%= pricing.stats.auction %> at auction price, <%= pricing.stats.waiver %> at waiver terms).
        Read <strong><%= pricing.draftCount %></strong> draft pick<%= pricing.draftCount===1?'':'s' %>
        from the <strong><%= pricing.auctionSeason %></strong> auction,
        <strong><%= pricing.draftPicksWithBid %></strong> with a bid amount.
      </div>

      <% if (pricing.draftCount === 0) { %>
        <div class="flash warn">
          ESPN returned <strong>no draft picks</strong> for the
          <strong><%= pricing.auctionSeason %></strong> auction season,
          so there were no auction prices to apply.
          <% if (pricing.draftError) { %><br>Draft-results request error: <%= pricing.draftError %><% } %>
          <br>Check that the <strong>Auction price season</strong> in step 1 matches the season whose
          auction you want to price, and that that season's auction has actually taken place.
        </div>
      <% } else if (pricing.draftPicksWithBid === 0) { %>
        <div class="flash warn">
          ESPN returned <%= pricing.draftCount %> draft picks but <strong>none carried a bid amount</strong>.
          That usually means the <%= pricing.auctionSeason %> draft was a <strong>snake draft</strong>
          (no auction prices) rather than an auction. Double-check the <strong>Auction price season</strong>
          in step 1, or set auction prices manually below.
        </div>
      <% } %>

      <% if (pricing.stats.auctionNoBid && pricing.stats.auctionNoBid.length) { %>
        <div class="flash warn">
          Drafted, but ESPN didn't report a bid amount for these players — set their price manually:
          <%= pricing.stats.auctionNoBid.join(', ') %>.
        </div>
      <% } %>

      <% if (pricing.stats.unmatchedTeams && pricing.stats.unmatchedTeams.length) { %>
        <div class="flash warn">
          <%= pricing.stats.unmatchedTeams.length %> ESPN team(s) aren't mapped to a site team yet,
          so their players were skipped. Map them in step 2 above, then set prices again.
        </div>
      <% } %>

      <% pricing.teams.forEach(function(t){ %>
        <h3 style="margin:14px 0 6px"><%= t.team %></h3>
        <table class="teams">
          <thead><tr><th>Player</th><th>Terms</th><th>Why</th></tr></thead>
          <tbody>
            <% t.offers.forEach(function(o){ %>
              <tr>
                <td><strong><%= o.player_name %></strong></td>
                <td>
                  <% if (o.acq_type === 'auction') { %>Auction · $<%= o.auction_price %>/yr · 1–3 yrs
                  <% } else { %>Waiver · $11 / $15 · 1–2 yrs<% } %>
                </td>
                <td class="hint"><%= o.reason %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% }); %>
      <p class="hint">These terms now appear on each team page (and the admin team editor). You can
        edit any player's terms before they're signed.</p>
    </div>
  <% } %>
</div>

<!-- 4b. Import auction prices from the Draft Recap PDF (private leagues) --->
<div class="card">
  <h2>4b. Import auction prices from a Draft Recap PDF</h2>
  <p class="hint">If step 4 priced your drafted players at <strong>$0</strong>, your league is almost
    certainly <strong>private</strong>, so ESPN's feed hides the winning bids. This step gets them a
    different way: in ESPN open <em>your league → History → the auction season → Draft Recap</em>,
    print that page to PDF, and upload it here. ESPN still tells us <strong>who</strong> was drafted
    versus picked up on waivers — the PDF just supplies each drafted player's <strong>price</strong>,
    matched by name. Run the roster sync (step 3) first.</p>
  <form method="post" action="/admin/espn/pricing-pdf" enctype="multipart/form-data">
    <div class="field">
      <label>ESPN “Draft Recap” PDF</label>
      <input type="file" name="recap_pdf" accept="application/pdf,.pdf" required />
    </div>
    <button class="btn green" type="submit">Import prices from PDF</button>
  </form>

  <% if (typeof pricingPdf !== 'undefined' && pricingPdf) { %>
    <div style="margin-top:18px">
      <div class="flash">
        Read <strong><%= pricingPdf.recapPlayers %></strong> auction prices from the
        <% if (pricingPdf.auctionSeason) { %><strong><%= pricingPdf.auctionSeason %></strong> <% } %>Draft
        Recap PDF (<%= pricingPdf.pages %> page<%= pricingPdf.pages===1?'':'s' %>), then priced
        <strong><%= pricingPdf.priced %></strong> roster players
        (<%= pricingPdf.stats.auction %> at auction price, <%= pricingPdf.stats.waiver %> at waiver terms).
      </div>

      <% if (pricingPdf.stats.auctionNoBid && pricingPdf.stats.auctionNoBid.length) { %>
        <div class="flash warn">
          ESPN says these players were drafted, but no matching price was found in the PDF —
          set their price manually (usually a spelling mismatch): <%= pricingPdf.stats.auctionNoBid.join(', ') %>.
        </div>
      <% } %>

      <% if (pricingPdf.stats.unmatchedTeams && pricingPdf.stats.unmatchedTeams.length) { %>
        <div class="flash warn">
          <%= pricingPdf.stats.unmatchedTeams.length %> ESPN team(s) aren't mapped to a site team yet,
          so their players were skipped. Map them in step 2, then import again.
        </div>
      <% } %>

      <% if (pricingPdf.warnings && pricingPdf.warnings.length) { %>
        <div class="flash warn"><%= pricingPdf.warnings.join(' ') %></div>
      <% } %>

      <% pricingPdf.teams.forEach(function(t){ %>
        <h3 style="margin:14px 0 6px"><%= t.team %></h3>
        <table class="teams">
          <thead><tr><th>Player</th><th>Terms</th><th>Why</th></tr></thead>
          <tbody>
            <% t.offers.forEach(function(o){ %>
              <tr>
                <td><strong><%= o.player_name %></strong></td>
                <td>
                  <% if (o.acq_type === 'auction') { %>Auction · $<%= o.auction_price %>/yr · 1–3 yrs
                  <% } else { %>Waiver · $11 / $15 · 1–2 yrs<% } %>
                </td>
                <td class="hint"><%= o.reason %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% }); %>

      <% if (pricingPdf.unmatchedRecap && pricingPdf.unmatchedRecap.length) { %>
        <p class="hint" style="margin-top:12px">Recap prices not applied to a current roster spot
          (dropped since the auction, or an unmatched name): <%= pricingPdf.unmatchedRecap.join(', ') %>.</p>
      <% } %>
      <p class="hint">These terms now appear on each team page and in the admin team editor. You can
        edit any player's terms before they're signed.</p>
    </div>
  <% } %>
</div>

<%- include('partials/foot') %>
