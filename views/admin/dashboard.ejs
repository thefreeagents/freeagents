<%- include('partials/head', { nav: 'teams' }) %>

<h1 class="admin-h1">Teams</h1>
<p class="admin-sub">Click a team to edit its name, owner, championships, and full roster.</p>

<% if (flash) { %><div class="flash"><%= flash==='deleted' ? 'Team deleted.' : 'Saved!' %></div><% } %>

<div class="offseason-bar <%= offseasonOn ? 'on' : '' %>">
  <div>
    <strong>Off-Season Mode</strong>
    <span class="state"><%= offseasonOn ? 'ON' : 'off' %></span>
    <p class="hint">When on, each team's edit page shows the off-season move buttons (drop / promote / sign). Turn it off during the season to lock rosters.</p>
  </div>
  <form method="post" action="/admin/offseason/toggle">
    <button class="btn <%= offseasonOn ? 'gray' : 'green' %>" type="submit">
      <%= offseasonOn ? 'Turn OFF' : 'Turn ON' %>
    </button>
  </form>
</div>

<div class="card">
  <h2>Email notifications</h2>
  <p class="hint" style="margin-top:0">
    When a team submits off-season moves you get an email. These come from the mail
    account configured in Render. Use the button below to send yourself a test.
  </p>

  <% if (mailOk) { %>
    <div class="flash">Test email sent to <%= mailOk %>. Check that inbox (and the spam folder).</div>
  <% } else if (mailErr) { %>
    <div class="flash warn">Couldn't send: <%= mailErr %></div>
  <% } %>

  <% if (mail.configured) { %>
    <table class="teams" style="margin-bottom:14px">
      <tbody>
        <tr><td><strong>Status</strong></td><td>Configured &#10003;</td></tr>
        <tr><td><strong>Mail server</strong></td><td><%= mail.host %>:<%= mail.port %> (<%= mail.secure ? 'SSL' : 'STARTTLS' %>)</td></tr>
        <tr><td><strong>Sends as</strong></td><td><%= mail.from %></td></tr>
        <tr><td><strong>Notices go to</strong></td><td><%= mail.notifyTo %></td></tr>
        <tr><td><strong>Certificate check</strong></td><td><%= mail.tlsInsecure ? 'relaxed (accepts shared cert)' : 'strict' %></td></tr>
      </tbody>
    </table>
  <% } else { %>
    <div class="flash warn">
      Email is <strong>not configured</strong>, so notices are being skipped. In Render &rarr;
      Environment, set <code>SMTP_HOST</code>, <code>SMTP_PORT</code> (465), <code>SMTP_USER</code>,
      <code>SMTP_PASS</code>, <code>MAIL_FROM</code> and <code>NOTIFY_EMAIL</code>, then redeploy.
    </div>
  <% } %>

  <form method="post" action="/admin/mail-test">
    <div class="field">
      <label>Send a test email to</label>
      <input type="email" name="to" value="<%= mail.notifyTo || '' %>" placeholder="you@example.com" required />
    </div>
    <button class="btn green" type="submit">Send test email</button>
  </form>
</div>

<div class="card">
  <table class="teams">
    <thead><tr><th>Team</th><th>Owner</th><th>Championships</th><th>Updated</th><th></th></tr></thead>
    <tbody>
      <% teams.forEach(function(t){ %>
        <tr>
          <td><strong><%= t.name %></strong></td>
          <td><%= t.owner || '—' %></td>
          <td><%= t.championships || '—' %></td>
          <td><%= t.updated_at || '—' %></td>
          <td style="text-align:right"><a class="btn small" href="/admin/teams/<%= t.id %>">Edit</a></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<div class="card">
  <h2>Add a new team</h2>
  <form method="post" action="/admin/teams/new">
    <div class="field"><input type="text" name="name" placeholder="New team name" required /></div>
    <button class="btn green" type="submit">Add Team</button>
  </form>
</div>

<%- include('partials/foot') %>
