<%- include('partials/header') %>

<a class="back-link" href="/">&larr; All Teams</a>

<div class="team-header">
  <% if (team.image) { %>
    <div class="team-hero"><img src="/uploads/<%= team.image %>" alt="<%= team.name %>" /></div>
  <% } else { %>
    <h2 class="team-name-plain"><%= team.name %></h2>
  <% } %>
  <% if (team.owner) { %><p class="team-owner">Owner: <strong><%= team.owner %></strong></p><% } %>
  <% if (team.tagline) { %><p class="team-tagline"><%= team.tagline %></p><% } %>
  <% if (champs.length) { %>
    <div class="trophies">
      <% champs.forEach(function(y){ %><span class="trophy">🏆<em><%= y %></em></span><% }); %>
    </div>
  <% } %>
</div>

<% if ((team.all_time_record && team.all_time_record.trim()) || (team.all_time_pf && team.all_time_pf.trim()) || team.all_time_seasons) { %>
  <div class="alltime">
    <h3 class="alltime-title">All-Time Record</h3>
    <div class="alltime-stats">
      <% if (team.all_time_record && team.all_time_record.trim()) { %>
        <div class="stat"><span class="num"><%= team.all_time_record %></span><span class="lbl">W–L</span></div>
      <% } %>
      <% if (champs.length) { %>
        <div class="stat"><span class="num"><%= champs.length %></span><span class="lbl">Titles</span></div>
      <% } %>
      <% if (team.all_time_seasons) { %>
        <div class="stat"><span class="num"><%= team.all_time_seasons %></span><span class="lbl">Seasons</span></div>
      <% } %>
      <% if (team.all_time_pf && team.all_time_pf.trim()) { %>
        <div class="stat"><span class="num"><%= team.all_time_pf %></span><span class="lbl">Points For</span></div>
      <% } %>
    </div>
  </div>
<% } %>

<% roster.forEach(function(s){ %>
  <% if (s.players.length) { %>
    <section class="roster-section section-<%= s.color %>">
      <h3 class="section-title"><%= s.label %></h3>
      <div class="player-grid">
        <% s.players.forEach(function(p){ %>
          <div class="player-card">
            <% if (p.image) { %><img class="player-img" src="/uploads/<%= p.image %>" alt="<%= p.name %>" /><% } %>
            <div class="player-name"><%= p.name %></div>
            <% if (p.contracts) { %>
              <div class="player-contracts">
                <% p.contracts.split(/\r?\n/).filter(Boolean).forEach(function(line){ %>
                  <span><%= line %></span>
                <% }); %>
              </div>
            <% } %>
          </div>
        <% }); %>
      </div>
    </section>
  <% } %>
<% }); %>

<% var anyPlayers = roster.some(function(s){return s.players.length;}); %>
<% if (!anyPlayers) { %>
  <p class="empty-note">No roster added yet. <% if (isAdmin) { %><a href="/admin/teams/<%= team.id %>">Add players &rarr;</a><% } %></p>
<% } %>

<%
  // Off-season controls appear only while Off-Season Mode is on AND the viewer
  // is allowed to manage THIS team (the commissioner, or this team's own owner).
  var canManageTeam = (typeof canManage === 'function') ? canManage(team) : false;
  var offOn = (typeof offseasonOn !== 'undefined') && offseasonOn && canManageTeam;
  var actionBase = '/team/' + team.slug;
%>
<% if (offOn) {
     var contractPlayers = (roster.find(function(r){return r.key==='contract';}) || {players:[]}).players;
     var taxiPlayers  = (roster.find(function(r){return r.key==='taxi';}) || {players:[]}).players;
     var ncaaPlayers  = (roster.find(function(r){return r.key==='ncaa_player';}) || {players:[]}).players;
     var ncaacPlayers = (roster.find(function(r){return r.key==='ncaa_contract';}) || {players:[]}).players;
     // Public page: only players the commissioner already marked eligible get a choice.
     var eligNcaa = ncaaPlayers.filter(function(p){ return p.eligible; });
     var taxiSpots = caps.taxi - counts.taxi;
     // Pull the player's price for the current season from their contract lines
     // (e.g. "2026: $12"), used to show the cost of a promote/retain/activate.
     var curYear = String(typeof startYear !== 'undefined' ? startYear : new Date().getFullYear());
     function priceFor(contracts){
       if (!contracts) return '';
       var found = '';
       contracts.split(/\r?\n/).forEach(function(line){
         var mm = line.match(/(\d{4})\s*:\s*\$?\s*(\d+)/);
         if (mm && mm[1] === curYear) found = '$' + mm[2];
       });
       return found;
     }
     function costLabel(base, contracts){
       var pr = priceFor(contracts);
       return pr ? (base + ' (' + pr + ')') : base;
     }
%>
<section class="offseason-panel" id="offseason">
  <h3 class="os-heading">Off-Season Moves</h3>
  <p class="os-note">Choose what to do with each player, then press <strong>Submit</strong> at the bottom
    to make all the moves at once. Nothing changes until you submit. Caps:
    max <%= caps.contract %> Contract Players, max <%= caps.taxi %> Taxi Squad players.
    <strong>All changes can be undone until the pre-season locks.</strong></p>

  <% if (typeof osmsg !== 'undefined' && osmsg) { %>
    <div class="os-flash <%= oswarn ? 'warn' : '' %>"><%= osmsg %></div>
  <% } %>

  <form method="post" action="<%= actionBase %>/moves/submit" id="osform" class="osform">

    <!-- Contract Players: retain / drop (penalty = current-season price) -->
    <div class="os-group">
      <h4>Contract Players <span class="cnt"><%= counts.contract %>/<%= caps.contract %></span></h4>
      <% if (!contractPlayers.length) { %>
        <p class="os-empty">No Contract Players.</p>
      <% } else { %>
        <% contractPlayers.forEach(function(p){ var pr = priceFor(p.contracts); %>
          <div class="os-row">
            <span class="os-name"><%= p.name %></span>
            <div class="os-choices" role="radiogroup" aria-label="<%= p.name %>">
              <label class="os-opt"><input type="radio" name="contract_<%= p.id %>" value="keep" checked
                       data-player="<%= p.name %>" data-move=""> <%= costLabel('Retain', p.contracts) %></label>
              <label class="os-opt danger"><input type="radio" name="contract_<%= p.id %>" value="drop"
                       data-player="<%= p.name %>" data-move="drop from Contract Players<%= pr ? ' (penalty ' + pr + ')' : '' %>"> Drop<%= pr ? ' (Penalty ' + pr + ')' : '' %></label>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>

    <!-- Taxi Squad: keep / promote to NCAA Contracts / drop -->
    <div class="os-group">
      <h4>Taxi Squad <span class="cnt"><%= counts.taxi %>/<%= caps.taxi %></span></h4>
      <% if (!taxiPlayers.length) { %>
        <p class="os-empty">No Taxi Squad players.</p>
      <% } else { %>
        <% taxiPlayers.forEach(function(p){ %>
          <div class="os-row">
            <span class="os-name"><%= p.name %></span>
            <div class="os-choices" role="radiogroup" aria-label="<%= p.name %>">
              <label class="os-opt"><input type="radio" name="taxi_<%= p.id %>" value="keep" checked
                       data-player="<%= p.name %>" data-move=""> Taxi</label>
              <label class="os-opt"><input type="radio" name="taxi_<%= p.id %>" value="promote"
                       data-player="<%= p.name %>" data-move="<%= costLabel('promote to NCAA Contracts', p.contracts) %>"> <%= costLabel('Promote to NCAA Contracts', p.contracts) %></label>
              <label class="os-opt danger"><input type="radio" name="taxi_<%= p.id %>" value="drop"
                       data-player="<%= p.name %>" data-move="drop from Taxi Squad"> Drop</label>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>

    <!-- NCAA Contracts: retain / drop -->
    <div class="os-group">
      <h4>NCAA Contracts</h4>
      <% if (!ncaacPlayers.length) { %>
        <p class="os-empty">No NCAA Contract players.</p>
      <% } else { %>
        <% ncaacPlayers.forEach(function(p){ %>
          <div class="os-row">
            <span class="os-name"><%= p.name %></span>
            <div class="os-choices" role="radiogroup" aria-label="<%= p.name %>">
              <label class="os-opt"><input type="radio" name="ncaac_<%= p.id %>" value="keep" checked
                       data-player="<%= p.name %>" data-move=""> <%= costLabel('Retain', p.contracts) %></label>
              <label class="os-opt danger"><input type="radio" name="ncaac_<%= p.id %>" value="drop"
                       data-player="<%= p.name %>" data-move="drop from NCAA Contracts"> Drop</label>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>

    <!-- NCAA Players (eligible only): keep / activate / taxi / drop -->
    <div class="os-group">
      <h4>NCAA Players</h4>
      <p class="os-note">The commissioner marks a player <strong>eligible</strong>; once eligible you choose
        to <strong>activate</strong> them to NCAA Contracts, move them to the <strong>Taxi Squad</strong>,
        or <strong>drop</strong> them. Taxi Squad has
        <%= taxiSpots %> open spot<%= taxiSpots === 1 ? '' : 's' %>.</p>
      <% if (!ncaaPlayers.length) { %>
        <p class="os-empty">No NCAA Players.</p>
      <% } else if (!eligNcaa.length) { %>
        <p class="os-empty">No NCAA Players are eligible for a move yet.</p>
      <% } else { %>
        <% eligNcaa.forEach(function(p){ %>
          <div class="os-row">
            <span class="os-name"><%= p.name %> <span class="tag ok">eligible</span></span>
            <div class="os-choices" role="radiogroup" aria-label="<%= p.name %>">
              <input type="radio" name="ncaa_<%= p.id %>" value="keep" hidden
                     data-player="<%= p.name %>" data-move="" data-elig="1">
              <label class="os-opt"><input type="radio" name="ncaa_<%= p.id %>" value="activate"
                       data-player="<%= p.name %>" data-move="<%= costLabel('activate to NCAA Contracts', p.contracts) %>"> <%= costLabel('Activate', p.contracts) %></label>
              <label class="os-opt"><input type="radio" name="ncaa_<%= p.id %>" value="taxi" checked
                       data-player="<%= p.name %>" data-move="promote to Taxi Squad"> Taxi</label>
              <label class="os-opt danger"><input type="radio" name="ncaa_<%= p.id %>" value="drop"
                       data-player="<%= p.name %>" data-move="drop from NCAA Players"> Drop</label>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>

    <!-- Sign from ESPN -> Contract Players -->
    <div class="os-group">
      <h4>Sign from ESPN → Contract Players <span class="cnt"><%= counts.contract %>/<%= caps.contract %></span></h4>
      <p class="os-note">The commissioner sets each player's contract terms; check a player to sign them on
        those terms and pick the length. Signings count toward the <%= caps.contract %>-player cap.</p>
      <% if (!espnPlayers.length) { %>
        <p class="os-empty">No players on the ESPN list. Run an ESPN Sync first, or all ESPN players are already categorized.</p>
      <% } else { %>
        <% espnPlayers.forEach(function(p){
             var offer = offers[p.name];
             var acq = offer ? offer.acq_type : 'auction';
             var yrs = maxYears(acq);
        %>
          <div class="os-row os-sign-row">
            <label class="os-sign-check">
              <input type="checkbox" name="sign_<%= p.id %>" value="1" <%= offer ? '' : 'disabled' %>
                     data-player="<%= p.name %>" data-move="sign to Contract Players">
              <span class="os-name"><%= p.name %></span>
            </label>
            <div class="os-sign-terms">
              <% if (offer) { %>
                <span class="tag ok"><%= offSummary(offer.acq_type, offer.auction_price) %></span>
                <label class="os-years">Years
                  <select name="years_<%= p.id %>">
                    <% for (var y=1; y<=yrs; y++){ %><option value="<%= y %>"><%= y %></option><% } %>
                  </select>
                </label>
              <% } else { %>
                <span class="tag">no terms set</span>
                <span class="os-hint">commissioner must set terms first</span>
              <% } %>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>

    <!-- Live "what will happen" summary, built by the script below -->
    <div class="os-pending" id="os-pending" hidden>
      <h4>Pending moves <span class="cnt" id="os-pending-count">0</span></h4>
      <ul id="os-pending-list"></ul>
    </div>
    <p class="os-pending-empty" id="os-pending-empty">No moves selected yet.</p>
    <p class="os-need" id="os-need" hidden></p>

    <div class="os-submitbar">
      <button class="btn green" type="submit" id="os-submit" disabled>Submit moves</button>
      <button class="btn gray" type="button" id="os-reset">Clear selections</button>
    </div>
  </form>
</section>

<script>
(function(){
  var form = document.getElementById('osform');
  if (!form) return;
  var listEl  = document.getElementById('os-pending-list');
  var wrapEl  = document.getElementById('os-pending');
  var emptyEl = document.getElementById('os-pending-empty');
  var countEl = document.getElementById('os-pending-count');
  var submit  = document.getElementById('os-submit');
  var needEl  = document.getElementById('os-need');

  // Eligible NCAA players must be given a real choice (Activate / Taxi / Drop)
  // before the form can be submitted — an eligible player left on "keep" blocks it.
  function undecidedEligible(){
    var names = [];
    form.querySelectorAll('input[type=radio][value="keep"][data-elig="1"]').forEach(function(keep){
      var checked = form.querySelector('input[name="' + keep.name + '"]:checked');
      if (!checked || checked.value === 'keep') names.push(keep.dataset.player || keep.name);
    });
    return names;
  }

  function selected(){
    var out = [];
    // Non-"keep" radios.
    form.querySelectorAll('input[type=radio]:checked').forEach(function(r){
      if (r.value !== 'keep' && r.dataset.move) {
        out.push({ el: r, player: r.dataset.player, move: r.dataset.move });
      }
    });
    // Checked sign boxes.
    form.querySelectorAll('input[type=checkbox]:checked').forEach(function(c){
      if (c.dataset.move) out.push({ el: c, player: c.dataset.player, move: c.dataset.move });
    });
    return out;
  }

  function clearOne(item){
    if (item.el.type === 'checkbox') { item.el.checked = false; }
    else {
      var keep = form.querySelector('input[name="' + item.el.name + '"][value="keep"]');
      if (keep) keep.checked = true;
    }
    render();
  }

  function render(){
    var items = selected();
    listEl.innerHTML = '';
    items.forEach(function(it){
      var li = document.createElement('li');
      var txt = document.createElement('span');
      txt.textContent = it.player + ' — ' + it.move;
      var rm = document.createElement('button');
      rm.type = 'button';
      rm.className = 'os-remove';
      rm.textContent = 'remove';
      rm.addEventListener('click', function(){ clearOne(it); });
      li.appendChild(txt);
      li.appendChild(rm);
      listEl.appendChild(li);
    });
    countEl.textContent = items.length;
    wrapEl.hidden = items.length === 0;
    emptyEl.hidden = items.length !== 0;
    var undecided = undecidedEligible();
    if (needEl){
      needEl.hidden = undecided.length === 0;
      if (undecided.length){
        needEl.textContent = 'Choose Activate, Taxi, or Drop for every eligible NCAA player before submitting: ' + undecided.join(', ') + '.';
      }
    }
    submit.disabled = (items.length === 0) || (undecided.length > 0);
  }

  form.addEventListener('change', render);
  document.getElementById('os-reset').addEventListener('click', function(){
    form.reset();
    render();
  });
  form.addEventListener('submit', function(e){
    var items = selected();
    if (!items.length || undecidedEligible().length) { e.preventDefault(); return; }
    if (!confirm('Submit ' + items.length + ' move' + (items.length===1?'':'s') + ' now?')) e.preventDefault();
  });
  render();
})();
</script>
<% } %>

<% if (canManageTeam && typeof txnGroups !== 'undefined' && txnGroups.length) { %>
  <section class="roster-section section-blue offseason-log">
    <h3 class="section-title">Offseason Submissions</h3>
    <ul class="txn-feed">
      <% txnGroups.forEach(function(g){ %>
        <li class="txn-group <%= g.allUndone ? 'undone' : '' %>">
          <div class="txn-group-head">
            <span class="txn-when"><%= g.created_at %><% if (g.allUndone) { %> · undone<% } %></span>
            <% if (offOn && !g.allUndone) { %>
              <% var undoAction = g.batchId != null
                   ? actionBase + '/moves/undo-batch/' + g.batchId
                   : actionBase + '/moves/undo/' + g.txnId; %>
              <form method="post" action="<%= undoAction %>"
                    onsubmit="return confirm('Undo this whole submission and reset the team to how it was before?');">
                <button class="btn small gray" type="submit">Undo submission</button>
              </form>
            <% } %>
          </div>
          <ul class="txn-items">
            <% g.items.forEach(function(tx){ %>
              <li class="<%= tx.undone ? 'undone' : '' %>"><%= tx.summary %></li>
            <% }); %>
          </ul>
        </li>
      <% }); %>
    </ul>
  </section>
<% } %>

<% if (team.updated_at) { %><p class="updated">Updated <%= team.updated_at %></p><% } %>

<%- include('partials/footer') %>
