<%- include('partials/header') %>

<a class="back-link" href="/">&larr; All Teams</a>

<div class="team-header">
  <% if (team.image) { %>
    <div class="team-hero"><img src="/uploads/<%= team.image %>" alt="<%= team.name %>" /></div>
  <% } else { %>
    <h2 class="team-name-plain"><%= team.name %></h2>
  <% } %>
  <% if (team.owner) { %><p class="team-owner">Owner: <strong><%= team.owner %></strong></p><% } %>
  <% if (team.tagline) { %><p class="team-tagline"><%= team.tagline %></p><% } %>
  <% if (champs.length) { %>
    <div class="trophies">
      <% champs.forEach(function(y){ %><span class="trophy">🏆<em><%= y %></em></span><% }); %>
    </div>
  <% } %>
</div>

<% if ((team.all_time_record && team.all_time_record.trim()) || (team.all_time_pf && team.all_time_pf.trim()) || team.all_time_seasons) { %>
  <div class="alltime">
    <h3 class="alltime-title">All-Time Record</h3>
    <div class="alltime-stats">
      <% if (team.all_time_record && team.all_time_record.trim()) { %>
        <div class="stat"><span class="num"><%= team.all_time_record %></span><span class="lbl">W–L</span></div>
      <% } %>
      <% if (champs.length) { %>
        <div class="stat"><span class="num"><%= champs.length %></span><span class="lbl">Titles</span></div>
      <% } %>
      <% if (team.all_time_seasons) { %>
        <div class="stat"><span class="num"><%= team.all_time_seasons %></span><span class="lbl">Seasons</span></div>
      <% } %>
      <% if (team.all_time_pf && team.all_time_pf.trim()) { %>
        <div class="stat"><span class="num"><%= team.all_time_pf %></span><span class="lbl">Points For</span></div>
      <% } %>
    </div>
  </div>
<% } %>

<% roster.forEach(function(s){ %>
  <% if (s.players.length) { %>
    <section class="roster-section section-<%= s.color %>">
      <h3 class="section-title"><%= s.label %></h3>
      <div class="player-grid">
        <% s.players.forEach(function(p){ %>
          <div class="player-card">
            <% if (p.image) { %><img class="player-img" src="/uploads/<%= p.image %>" alt="<%= p.name %>" /><% } %>
            <div class="player-name"><%= p.name %></div>
            <% if (p.contracts) { %>
              <div class="player-contracts">
                <% p.contracts.split(/\r?\n/).filter(Boolean).forEach(function(line){ %>
                  <span><%= line %></span>
                <% }); %>
              </div>
            <% } %>
          </div>
        <% }); %>
      </div>
    </section>
  <% } %>
<% }); %>

<% var anyPlayers = roster.some(function(s){return s.players.length;}); %>
<% if (!anyPlayers) { %>
  <p class="empty-note">No roster added yet. <% if (isAdmin) { %><a href="/admin/teams/<%= team.id %>">Add players &rarr;</a><% } %></p>
<% } %>

<%
  // Off-season controls appear on the team page only while Off-Season Mode is on.
  var offOn = (typeof offseasonOn !== 'undefined') && offseasonOn;
  var actionBase = '/team/' + team.slug;
%>
<% if (offOn) {
     var taxiPlayers  = (roster.find(function(r){return r.key==='taxi';}) || {players:[]}).players;
     var ncaaPlayers  = (roster.find(function(r){return r.key==='ncaa_player';}) || {players:[]}).players;
     var ncaacPlayers = (roster.find(function(r){return r.key==='ncaa_contract';}) || {players:[]}).players;
     var taxiFull = counts.taxi >= caps.taxi;
     var contractFull = counts.contract >= caps.contract;
     var moveMsg = {
       dropped:        'Player dropped from the Taxi Squad.',
       dropped_ncaac:  'Player dropped from NCAA Contracts.',
       promoted_ncaac: 'Promoted to NCAA Contracts.',
       promoted_taxi:  'Promoted to the Taxi Squad.',
       not_eligible:   'That player must be marked eligible first.',
       taxi_full:      'Taxi Squad is full (max ' + caps.taxi + ').',
       offer_saved:    'Contract terms saved.',
       signed:         'Signed as a Contract Player.',
       contract_full:  'Contract Players is full (max ' + caps.contract + ').',
       bad_terms:      'Please set valid contract terms (acquisition type, price, and years).',
       undone:         'Move undone.'
     };
     var warnMoves = ['not_eligible','taxi_full','contract_full','bad_terms'];
%>
<section class="offseason-panel">
  <h3 class="os-heading">Off-Season Moves</h3>
  <p class="os-note">Off-Season Mode is <strong>ON</strong>. These buttons take effect immediately.
    Caps: max <%= caps.contract %> Contract Players, max <%= caps.taxi %> Taxi Squad players.</p>

  <% if (move && moveMsg[move]) { %>
    <div class="os-flash <%= warnMoves.indexOf(move)>=0 ? 'warn' : '' %>"><%= moveMsg[move] %></div>
  <% } %>

  <!-- Taxi Squad moves -->
  <div class="os-group">
    <h4>Taxi Squad <span class="cnt"><%= counts.taxi %>/<%= caps.taxi %></span></h4>
    <% if (!taxiPlayers.length) { %>
      <p class="os-empty">No Taxi Squad players.</p>
    <% } else { %>
      <% taxiPlayers.forEach(function(p){ %>
        <div class="os-row">
          <span class="os-name"><%= p.name %></span>
          <div class="os-actions">
            <form method="post" action="<%= actionBase %>/moves/taxi-to-ncaac/<%= p.id %>">
              <button class="btn small green" type="submit">Promote to NCAA Contracts</button>
            </form>
            <form method="post" action="<%= actionBase %>/moves/drop/<%= p.id %>"
                  onsubmit="return confirm('Drop <%= p.name.replace(/'/g, "\\'") %> from the Taxi Squad?');">
              <button class="btn small danger" type="submit">Drop</button>
            </form>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>

  <!-- NCAA Contracts: drop -->
  <div class="os-group">
    <h4>NCAA Contracts</h4>
    <% if (!ncaacPlayers.length) { %>
      <p class="os-empty">No NCAA Contract players.</p>
    <% } else { %>
      <% ncaacPlayers.forEach(function(p){ %>
        <div class="os-row">
          <span class="os-name"><%= p.name %></span>
          <div class="os-actions">
            <form method="post" action="<%= actionBase %>/moves/drop-ncaac/<%= p.id %>"
                  onsubmit="return confirm('Drop <%= p.name.replace(/'/g, "\\'") %> from NCAA Contracts?');">
              <button class="btn small danger" type="submit">Drop</button>
            </form>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>

  <!-- NCAA Players -> Taxi Squad -->
  <div class="os-group">
    <h4>NCAA Players → Taxi Squad</h4>
    <p class="os-note">The commissioner marks a player <strong>eligible</strong>; once eligible you can
      promote them. Taxi Squad has
      <%= caps.taxi - counts.taxi %> open spot<%= (caps.taxi - counts.taxi)===1 ? '' : 's' %>.</p>
    <% if (!ncaaPlayers.length) { %>
      <p class="os-empty">No NCAA Players.</p>
    <% } else { %>
      <% ncaaPlayers.forEach(function(p){ %>
        <div class="os-row">
          <span class="os-name">
            <%= p.name %>
            <% if (p.eligible) { %><span class="tag ok">eligible</span>
            <% } else { %><span class="tag">not eligible yet</span><% } %>
          </span>
          <div class="os-actions">
            <form method="post" action="<%= actionBase %>/moves/ncaa-to-taxi/<%= p.id %>">
              <button class="btn small green" type="submit" <%= (!p.eligible || taxiFull) ? 'disabled' : '' %>>
                Promote to Taxi Squad
              </button>
            </form>
          </div>
        </div>
      <% }); %>
    <% } %>
  </div>

  <!-- Sign from ESPN -> Contract Players -->
  <div class="os-group">
    <h4>Sign from ESPN → Contract Players <span class="cnt"><%= counts.contract %>/<%= caps.contract %></span></h4>
    <p class="os-note">The commissioner sets each player's contract terms; you can sign a player
      on those terms once they're set. <% if (contractFull) { %><span class="tag warn">roster full</span><% } %></p>
    <% if (!espnPlayers.length) { %>
      <p class="os-empty">No players on the ESPN list. Run an ESPN Sync first, or all ESPN players are already categorized.</p>
    <% } else { %>
      <% espnPlayers.forEach(function(p){
           var offer = offers[p.name];
           var acq = offer ? offer.acq_type : 'auction';
           var yrs = maxYears(acq);
      %>
        <div class="os-espn">
          <div class="os-espn-head">
            <span class="os-name"><%= p.name %></span>
            <% if (offer) { %><span class="tag ok"><%= offSummary(offer.acq_type, offer.auction_price) %></span><% } else { %><span class="tag">no terms set</span><% } %>
          </div>

          <form method="post" action="<%= actionBase %>/moves/sign" class="os-sign">
            <input type="hidden" name="player_name" value="<%= p.name %>" />
            <label>Years
              <select name="years">
                <% for (var y=1; y<=yrs; y++){ %><option value="<%= y %>"><%= y %></option><% } %>
              </select>
            </label>
            <button class="btn small green" type="submit" <%= (!offer || contractFull) ? 'disabled' : '' %>>Sign as Contract Player</button>
            <% if (!offer) { %><span class="os-hint">commissioner must set terms first</span><% } %>
          </form>
        </div>
      <% }); %>
    <% } %>
  </div>
</section>
<% } %>

<% if (typeof transactions !== 'undefined' && transactions.length) { %>
  <section class="roster-section section-blue offseason-log">
    <h3 class="section-title">Offseason Transactions</h3>
    <ul class="txn-feed">
      <% transactions.forEach(function(tx){ %>
        <li class="<%= tx.undone ? 'undone' : '' %>">
          <span class="txn-text"><%= tx.summary %></span>
          <span class="txn-side">
            <span class="txn-when"><%= tx.created_at %><% if (tx.undone) { %> · undone<% } %></span>
            <% if (offOn && !tx.undone) { %>
              <form method="post" action="<%= actionBase %>/moves/undo/<%= tx.id %>"
                    onsubmit="return confirm('Undo this move?');">
                <button class="btn small gray" type="submit">Undo</button>
              </form>
            <% } %>
          </span>
        </li>
      <% }); %>
    </ul>
  </section>
<% } %>

<% if (team.updated_at) { %><p class="updated">Updated <%= team.updated_at %></p><% } %>

<%- include('partials/footer') %>
