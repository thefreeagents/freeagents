<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= settings.site_title || 'The Free Agents' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Bangers&family=Barlow+Condensed:wght@500;600;700&family=Barlow:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/style.css" />
</head>
<body>
  <header class="site-banner">
    <% if (settings.banner_image) { %>
      <img class="banner-img" src="/uploads/<%= settings.banner_image %>" alt="<%= settings.site_title %>" />
    <% } else { %>
      <div class="banner-fallback">
        <div class="banner-lights"></div>
        <h1 class="banner-title"><%= settings.site_title || 'THE FREE AGENTS' %></h1>
        <% if (settings.site_subtitle) { %><p class="banner-sub"><%= settings.site_subtitle %></p><% } %>
      </div>
    <% } %>
  </header>

  <nav class="mainnav">
    <ul>
      <li><a class="<%= (typeof active!=='undefined'&&active==='teams')?'on':'' %>" href="/">Teams</a></li>
      <% (navPages || []).forEach(function(p){ %>
        <li><a class="<%= (typeof active!=='undefined'&&active===p.slug)?'on':'' %>" href="/page/<%= p.slug %>"><%= p.label %></a></li>
      <% }); %>
      <% if (isAdmin) { %><li class="admin-link"><a href="/admin">Admin</a></li><% } %>
    </ul>
  </nav>

  <main class="wrap">
